+				char *desc=exit_reason_get_string_desc(p->p_exit_reason);
+				printf("PANDORA BT EXIT: namespace=%u code=%#llx description=%s\n",
+				    p->p_exit_reason->osr_namespace,p->p_exit_reason->osr_code,desc?desc:"(none)");
+			}
+		}
+	}
+#endif
 	p->p_xstat = rv;
